# Copy this file to ".env" and fill in real values there. ".env" is
# gitignored - never commit it or share it in chat/screenshots.

BAMBOO_USERNAME='bamboo-username'
BAMBOO_PASSWORD='bamboo-password'

# Only needed if ssh.auth_method is "password" in config.yaml.
SSH_PASSWORD='ssh-password'

# Only needed if webhook.enabled is true in config.yaml.
WEBHOOK_TOKEN=
